%!PS-Adobe-3.0 EPSF-3.0
%%Creator: Kinscope brand sheet
%%Title: Kinscope mark
%%BoundingBox: 0 0 288 270
%%HiResBoundingBox: 0 0 288 270
%%EndComments
%%BeginProlog
/ink { 0.075 0.118 0.114 setrgbcolor } bind def
/teal { 0.361 0.635 0.675 setrgbcolor } bind def
%%EndProlog
gsave
3 3 scale
1 setlinecap
1 setlinejoin
% ---- teal arcs (scope) ----
teal
7 setlinewidth
newpath 46 47 43 125 20 arcn stroke
newpath 46 47 43 0 -62 arcn stroke
% ---- teal bars (rising figures) ----
6 setlinewidth
newpath 6 20.5 moveto 6 30 lineto stroke
newpath 14.5 20.5 moveto 14.5 37 lineto stroke
newpath 22 20.5 moveto 22 45 lineto stroke
% ---- ink K ----
ink
13 setlinewidth
newpath 33.5 24 moveto 33.5 70 lineto stroke
newpath 68 70 moveto 44 47 lineto 68 24 lineto stroke
grestore
showpage
%%EOF
